# APDL local development environment
# Copy to .env and fill in the optional credentials you need:
#   cp .env.example .env

# ── Common ──────────────────────────────────────────────────────────

# Shared data-store credentials
CLICKHOUSE_USER=apdl
CLICKHOUSE_PASSWORD=apdl_dev
CLICKHOUSE_DB=apdl

# Platform encryption key for Agents-owned project LLM credentials.
AGENTS_LLM_CREDENTIAL_ENCRYPTION_KEY_BASE64=

LOG_LEVEL=info

# Redis uses no eviction so accepted stream data is never silently discarded.
APDL_REDIS_MAXMEMORY=1gb

# Local Compose bootstrap password for the non-owner runtime database role.
APDL_RUNTIME_POSTGRES_PASSWORD=apdl_runtime_dev

# ── Admin API ───────────────────────────────────────────────────────

# Loopback-only onboarding starts empty and lets you register an account, then
# create the first project in Workspace settings. Disable registration and use
# secure cookies before exposing Admin outside local development.
APDL_ADMIN_COOKIE_SECURE=false
APDL_ADMIN_REGISTRATION_ENABLED=true
APDL_ADMIN_MAX_ACCOUNTS=100
APDL_ADMIN_MAX_PROJECTS_PER_USER=5

# Replace this local-only value with a unique production secret.
APDL_ADMIN_LOGIN_RISK_HMAC_KEY=local-admin-login-risk-key-change-me
APDL_ADMIN_STREAM_AUTH_CHECK_SECONDS=5
APDL_ADMIN_UPSTREAM_READ_TIMEOUT_SECONDS=60
APDL_ADMIN_READINESS_PROBE_TIMEOUT_SECONDS=2

# ── Config Service ──────────────────────────────────────────────────

SSE_CREDENTIAL_CHECK_INTERVAL_SECONDS=5
CONFIG_OUTBOX_DEGRADED_MAX_PENDING_AGE_SECONDS=300
CONFIG_OUTBOX_DEGRADED_MAX_QUARANTINED_ROWS=0

# ── Agents Service ──────────────────────────────────────────────────

# Optional OpenAI-compatible local endpoint
LOCAL_LLM_URL=

# ── Codegen Service ─────────────────────────────────────────────────

# GitHub App credentials. Encode the PEM as one standard Base64 line with:
# openssl base64 -A -in path/to/github-app.private-key.pem
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_API_URL=https://api.github.com

# Empty disables the webhook endpoint; CI polling remains available.
GITHUB_WEBHOOK_SECRET=

# Emergency controls
CODEGEN_KILL_SWITCH=
CODEGEN_DISABLED_PROJECTS=

# Platform encryption key for Codegen-owned project LLM credentials.
# Generate exactly 32 random bytes as canonical standard Base64.
CODEGEN_LLM_CREDENTIAL_ENCRYPTION_KEY_BASE64=
# Same absolute, host-visible path in the controller and nested editor.
CODEGEN_LLM_BROKER_DIR=/tmp/apdl-codegen-llm-broker

# Runtime identity. Normal development remains offline; the secure tenant
# deployment overlay selects tenant_draft_pr explicitly.
CODEGEN_REVISION=development-unversioned
CODEGEN_ROLLOUT_STAGE=offline

# Optional platform policy
CODEGEN_PLATFORM_SAFETY_POLICY_PATH=

# Edit and review behavior
CODEGEN_BRIEF=true
CODEGEN_REVIEW=true
CODEGEN_EDIT_RETRIES=1
CODEGEN_AIDER_BIN=aider
CODEGEN_REQUIRE_VERIFY=false
CODEGEN_CACHE_PROMPTS=true
CODEGEN_CONVENTIONS=true
CODEGEN_SDK_REFERENCE=false
CODEGEN_CONTRACTS=true
CODEGEN_CONTRACT_INSTALL_TIMEOUT=600
CODEGEN_TIMEOUT=1800
CODEGEN_GIT_TIMEOUT=300
CODEGEN_LLM_TIMEOUT=240
CODEGEN_JOB_BUDGET=3000

# CI recovery
CODEGEN_CI_POLL_INTERVAL=60
CODEGEN_CI_REPAIR_RETRIES=2
CODEGEN_CI_REPAIR_BUDGET_SECONDS=3600

# Isolated worker and tenant-runtime egress
CODEGEN_SANDBOX=docker
CODEGEN_SANDBOX_IMAGE=
CODEGEN_SANDBOX_NETWORK=
CODEGEN_CONTROLLER_IMAGE_ID=
CODEGEN_EGRESS_POLICY_SHA256=
CODEGEN_EGRESS_PROXY_IMAGE_ID=
CODEGEN_EGRESS_SOCKET_VOLUME=
CODEGEN_EGRESS_PROXY_URL=http://127.0.0.1:3128
CODEGEN_TRUSTED_REPOS_ONLY=false

# Tenant-runtime Docker settings; Make normally derives these from the host.
CODEGEN_DOCKER_SOCKET=
CODEGEN_DOCKER_UID=
CODEGEN_DOCKER_GID=
CODEGEN_DOCKER_SOCKET_GID=

# ── ClickHouse Writer ───────────────────────────────────────────────

CLICKHOUSE_NATIVE_URL=clickhouse://apdl:apdl_dev@localhost:9000/apdl
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5
CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=30
CLICKHOUSE_SYNC_REQUEST_TIMEOUT_SECONDS=5
SHUTDOWN_TIMEOUT_SECONDS=10

# ── Routing ─────────────────────────────────────────────────────────

# Local dependency endpoints
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://apdl_runtime:apdl_runtime_dev@localhost:5432/apdl
CLICKHOUSE_URL=http://localhost:8123

# Local inter-service endpoints
INGESTION_SERVICE_URL=http://localhost:8080
CONFIG_SERVICE_URL=http://localhost:8081
QUERY_SERVICE_URL=http://localhost:8082
AGENTS_SERVICE_URL=http://localhost:8083
CODEGEN_SERVICE_URL=http://localhost:8084
ADMIN_API_URL=http://localhost:8085

# Browser and trusted-proxy boundaries for the Admin API
APDL_ADMIN_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
APDL_ADMIN_TRUSTED_PROXY_CIDRS=["172.30.255.0/28"]
